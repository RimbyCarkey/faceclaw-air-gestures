<?xml version='1.0' encoding='UTF-8'?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    
    <uses-permission android:name="android.permission.INTERNET" />
    
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    
    
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        
        <package android:name="dev.kb896.store" />
    </queries>

    <application>
        <activity android:name=".MainActivity" android:exported="false">
            </activity>

        <activity android:name=".GesturesActivity" android:exported="false" />
        <activity android:name=".ProfileActivity" android:exported="false" />
        <activity android:name=".BandProfilesActivity" android:exported="false" />
        <activity android:name=".BandControlActivity" android:exported="false" />
        <activity android:name=".CallsActivity" android:exported="false" />
        <activity android:name=".HandwritingActivity" android:exported="false" />
        <activity android:name=".GestureActivity" android:exported="false" />
        <activity android:name=".DragsActivity" android:exported="false" />
        <activity android:name=".PalmCalibrationActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
        <activity android:name=".TeachDragsActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
        <activity android:name=".DrawingsActivity" android:exported="false" />
        <activity android:name=".TeachDrawingActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
        <activity android:name=".PracticeActivity" android:exported="false" />
        <activity android:name=".SequenceActivity" android:exported="false" />
        <activity android:name=".HomeDevicesActivity" android:exported="false" />

        <receiver android:name=".SequenceRunner" android:exported="false" />

        
        <receiver android:name=".ProfileReceiver" android:exported="false">
            <intent-filter>
                <action android:name="dev.kb896.airgestures.SET_PROFILE" />
            </intent-filter>
        </receiver>
        <activity android:name=".SetupActivity" android:exported="false" />
        <activity android:name=".FirmwareActivity" android:exported="false" />
        <activity android:name=".PersonalWordsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CreditsActivity" android:exported="false" />
        <activity android:name=".LicensesActivity" android:exported="false" />
        <activity android:name=".ActivityLogActivity" android:exported="false" />
        
        <activity android:name=".ProfilePickerActivity" android:exported="false" android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="" android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity android:name=".MetaSignIn" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" android:process=":band_enrollment" />

        <receiver android:name=".ReminderReceiver" android:exported="false" />

        <receiver android:name=".BandWidget" android:exported="false" android:label="@string/tile_band">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/band_widget" />
        </receiver>

        <service android:name=".BandTile" android:exported="true" android:icon="@drawable/ic_power" android:label="@string/tile_band" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
            
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service android:name=".ControlsTile" android:exported="true" android:icon="@drawable/ic_hand" android:label="@string/tile_controls" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
            
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <receiver android:name=".RestartReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service android:name=".BandService" android:exported="false" android:foregroundServiceType="connectedDevice" />

        <service android:name=".TouchService" android:exported="false" android:label="Faceclaw band screen gestures" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/touch_service" />
        </service>

        <service android:name=".WriteService" android:exported="false" android:label="Faceclaw band handwriting in text fields" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/write_service" />
        </service>

        <service android:name=".NavigateService" android:exported="false" android:label="Faceclaw band navigation" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/navigate_service" />
        </service>

        
        <service android:name=".MediaAccess" android:exported="true" android:label="Faceclaw band media and notifications" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service android:name=".BandPresenceService" android:exported="true" android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>
    </application>
</manifest>